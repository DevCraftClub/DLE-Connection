{# Rules embed for category automation — ConnectionsAutomation #}
<div class="dc-conn-auto-rules" data-dc-conn-auto-rules data-category-id="{{ category_id|default(0) }}">
	<div class="d-flex flex-align-center flex-justify-between mb-2">
		<div>
			<strong>{{ 'Правила автоматизации'|trans }}</strong>
			<p class="text-muted text-small mb-0">
				{{ 'Несколько активных правил допускаются; при сохранении сборки с конфликтом нужен ручной Automate.'|trans }}
			</p>
		</div>
		<div class="d-flex flex-align-center" style="gap: 0.5rem;">
			<button type="button" class="button small primary" data-dc-conn-auto-rule-add-linear>
				{{ 'Добавить линейное'|trans }}
			</button>
			<button type="button" class="button small" data-dc-conn-auto-rule-add>
				{{ 'Добавить правило'|trans }}
			</button>
		</div>
	</div>
	<table class="table striped table-border text-small">
		<thead>
			<tr>
				<th>{{ 'Название'|trans }}</th>
				<th>{{ 'Паттерн'|trans }}</th>
				<th>{{ 'Активно'|trans }}</th>
				<th data-sortable="false">{{ 'Действия'|trans }}</th>
			</tr>
		</thead>
		<tbody data-dc-conn-auto-rule-list>
			<tr data-dc-conn-auto-rule-empty>
				<td colspan="4">{{ 'Правил пока нет'|trans }}</td>
			</tr>
		</tbody>
	</table>
</div>
