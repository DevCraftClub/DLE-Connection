<div id="dc-conn-relation-types" data-dc-conn-rtype-page="1" data-assets-base="{{ assets_base }}">
	<div class="d-flex flex-align-center flex-justify-between mb-3">
		<div>
			<h2 class="mb-0">{{ page_title|default('Типы связей'|trans) }}</h2>
			<p class="text-muted text-small mb-0">
				{{ 'Типы используются при добавлении новости в сборку.'|trans }}
			</p>
		</div>
		<button type="button" class="button primary" data-dc-conn-rtype-add>
			{{ 'Добавить тип'|trans }}
		</button>
	</div>

	{% include 'core/includes/form/filter_bar.twig' with {
		mod: mod,
		action: action,
		filter_catalog: filter_catalog,
		filter_rules: filter_rules,
		filter_chips: filter_chips,
		order: order,
		sort: sort
	} only %}

	<p class="text-small mb-2">{{ total|default(0) }} {{ 'записей'|trans }}</p>

	<table id="dc-conn-rtype-table"
		   class="table striped table-border mt-2"
		   data-role="table"
		   data-show-search="true"
		   data-show-rows-steps="false"
		   data-show-table-info="false"
		   data-show-pagination="false"
		   data-rows="{{ per_page|default(100) }}"
		   data-search-fields="name,id"
		   data-table-search-placeholder="{{ 'Поиск…'|trans }}">
		<thead>
			<tr>
				<th name="id">ID</th>
				<th name="name">{{ 'Название'|trans }}</th>
				<th name="actions" data-sortable="false">{{ 'Действия'|trans }}</th>
			</tr>
		</thead>
		<tbody data-dc-conn-rtype-list>
			{% for type in relation_types %}
				<tr data-id="{{ type.id }}">
					<td>{{ type.id }}</td>
					<td class="dc-conn-rtype-name">{{ type.name }}</td>
					<td>
						<button type="button" class="button small" data-dc-conn-rtype-rename>
							{{ 'Переименовать'|trans }}
						</button>
						<button type="button" class="button alert small" data-dc-conn-rtype-delete>
							{{ 'Удалить'|trans }}
						</button>
					</td>
				</tr>
			{% else %}
				<tr data-dc-conn-rtype-empty>
					<td colspan="3">{{ 'Типов пока нет'|trans }}</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
	{% include '@connections/partials/dialogs.twig' %}
</div>
