<div class="dc-conn-dashboard" id="dc-conn-dashboard"
	 data-assets-base="{{ assets_base }}"
	 data-dc-conn-tree='{{ tree|json_encode|e('html_attr') }}'
	 data-dc-conn-types='{{ relation_types|json_encode|e('html_attr') }}'>
	<div class="d-flex flex-align-center flex-justify-between mb-3">
		<div>
			<h4 class="mb-0">{{ page_title|default('Связи'|trans) }}</h4>
			<p class="text-muted text-small mb-0">{{ 'Сборки связанных новостей. Перетаскивайте сборки и элементы.'|trans }}</p>
		</div>
		<button type="button" class="button primary" data-dc-conn-add-collection>
			<img src="{{ assets_base }}/add-collection.svg" alt="" width="16" height="16" class="mr-1">
			{{ 'Новая сборка'|trans }}
		</button>
	</div>

	<div class="dc-conn-tree" data-dc-conn-collections></div>
</div>
