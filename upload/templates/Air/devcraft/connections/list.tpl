<section class="dc-connections-collection" aria-labelledby="dc-conn-{collection-id}" data-category="{category-slug}">
	<header class="section-heading dc-connections-head">
		<div>
			<h2 id="dc-conn-{collection-id}">{collection-title}</h2>
			[has value="{collection-description}"]
			<p>{collection-description}</p>
			[/has]
		</div>
	</header>
	<ul class="dc-connections-items">
		{items}
	</ul>
</section>
