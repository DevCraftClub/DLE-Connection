<li class="dc-connections-item dc-connections-item--timeline">
	[has value="{date-iso}"]
	<time class="dc-connections-date" datetime="{date-iso}">{date}</time>
	[/has]
	<a href="{full-link}" class="dc-connections-link">{title}</a>
	[has value="{relation-type}"]
	<span class="dc-connections-type">{relation-type}</span>
	[/has]
	[has value="{comment}"]
	<span class="dc-connections-comment">{comment}</span>
	[/has]
</li>
