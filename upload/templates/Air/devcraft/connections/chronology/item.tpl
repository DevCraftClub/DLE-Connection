<li class="dc-connections-item dc-connections-item--timeline">
	[has value="{date-iso}"]
	<time class="meta-item dc-connections-date" datetime="{date-iso}"><svg class="icon" aria-hidden="true"><use href="#i-clock"></use></svg>{date}</time>
	[/has]
	<a href="{full-link}" class="dc-connections-link">{title}</a>
	[has value="{relation-type}"]
	<span class="chips chips--rub">{relation-type}</span>
	[/has]
	[has value="{comment}"]
	<p class="dc-connections-comment">{comment}</p>
	[/has]
</li>
